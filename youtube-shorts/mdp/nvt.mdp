; NVT equilibration — 100 ps, 300 K, position restraints
integrator      = md
dt              = 0.002
nsteps          = 50000
cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz
tcoupl          = V-rescale
tc-grps         = System
tau_t           = 0.1
ref_t           = 300
pcoupl          = no
gen_vel         = yes
gen_temp        = 300
constraints     = h-bonds
constraint_algorithm = lincs
define          = -DPOSRES
