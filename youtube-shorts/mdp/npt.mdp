; NPT equilibration — 100 ps, 300 K, 1 bar, position restraints
integrator      = md
dt              = 0.002
nsteps          = 50000
cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz
tcoupl          = V-rescale
tc-grps         = System
tau_t           = 0.1
ref_t           = 300
pcoupl          = C-rescale
pcoupltype      = isotropic
tau_p           = 2.0
ref_p           = 1.0
compressibility = 4.5e-5
gen_vel         = no
refcoord_scaling = com
constraints     = h-bonds
constraint_algorithm = lincs
define          = -DPOSRES
continuation    = yes
